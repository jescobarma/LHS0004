
ds <- get(load("../../data/derived/LHS000401.rda"))
OBS_ <- c(1:nrow(ds))
ds <- data.frame(ds, OBS_)

f = file("bbdesign.smp", "rb")
OBS_ <- readBin(f, double(), 58475000)
close(f)
IMPL_ <- c(1:58475000)
IMPL_ <- floor((IMPL_ - 1) / 116950) + 1
smp <- data.frame(OBS_, IMPL_)
smp <- smp[order(smp$OBS_, smp$IMPL_),]

ds <- merge(smp, ds, by = "OBS_")

ds <- ds[order(ds$IMPL_, ds$OBS_),]
save(ds, file="../../data/derived/LHS000402.rda")

