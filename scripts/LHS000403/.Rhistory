# Load libraries
library(mice)
library(dplyr)
source('../LHS000490/')
### Clean environment
rm(list = ls())
## load data from FPBB algorithm
load('../../data/derived/LHS000402.rda')
## Inspects the variables with missing values
colSums(is.na(ds))
## Defines a specific method to each variable
init_method <- make.method(ds)
# Customize imputation methods based on variable types:
init_method["birth_order_spacing_c5"] <- "pmm"  # ordered logistic regression
init_method["any_substance_use"] <- "logreg"      # logistic regression
init_method["anc_quality_score_c2"] <- "logreg"   # logistic regression
init_method["underwt_birth"] <- "logreg"   # logistic regression
# Define predictor matrix (which variables predict which)
#   By default, all variables predict all others
pred_matrix <- make.predictorMatrix(ds)
pred_matrix[, c("OBS_", "IMPL_", "psu", "weight","region","strata")] <- 0
## Multiple imputation with seed for reproducibility
##  Imputed datasets: 5
##  Iterations: 10
imputed_data <- mice(
data = ds,
m = 5,
method = init_method,
predictorMatrix = pred_matrix,
maxit = 10,
printFlag = TRUE,
seed = 123
)
# split dataset by IMPL_
split_data <- split(ds, ds$IMPL_)
## Multiple imputation with seed for reproducibility
##  Imputed datasets: 5
##  Iterations: 10
imputed_list <- lapply(split_data, function(data){
mice(
data = ds,
m = 5,
method = init_method,
predictorMatrix = pred_matrix,
maxit = 10,
printFlag = TRUE,
seed = 123
)
})
